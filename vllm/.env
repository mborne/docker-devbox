DEVBOX_HOSTNAME=dev.localhost
VLLM_VERSION=v0.33.0
VLLM_MODEL=Qwen/Qwen3.5-0.8B
VLLM_SERVED_MODEL_NAME=qwen3.5-0.8b
VLLM_MAX_MODEL_LEN=8192
# max number of concurrent requests
VLLM_MAX_NUM_SEQS=16
# tool call parser matching VLLM_MODEL (see https://docs.vllm.ai/en/stable/features/tool_calling.html)
VLLM_TOOL_CALL_PARSER=qwen3_coder
# fraction of the GPU memory used by vLLM
VLLM_GPU_MEMORY_UTILIZATION=0.75
